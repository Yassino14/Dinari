<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dinari (Assistant Financier TND)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" asp-controller="Dashboard" asp-action="Index">
                Dinari · Assistant TND
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Tableau de bord</a>
                <a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a>
                <a class="nav-link btn btn-warning text-dark fw-semibold ms-2 px-3" asp-controller="Transactions" asp-action="Import">
                    Importer CSV
                </a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
