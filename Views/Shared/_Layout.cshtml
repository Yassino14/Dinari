@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Dinari · Intelligence Financière TND</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-dinari sticky-top shadow-sm py-2 mb-4">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Dashboard" asp-action="Index">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-warning text-dark fw-extrabold px-2 py-1">
                    <i class="bi bi-coin me-1"></i>TND
                </span>
                <span>Dinari <small class="text-warning fw-normal fs-6">FinTech</small></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#dinariNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="dinariNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1 text-warning"></i>Tableau de bord
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Dashboard" && currentAction == "Journal" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Journal">
                            <i class="bi bi-journal-bookmark-fill me-1 text-info"></i>Journal Revenus & Dépenses
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Dashboard" && currentAction == "Bilan" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Bilan">
                            <i class="bi bi-piggy-bank-fill me-1 text-success"></i>Bilan & Conseils Épargne
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Transactions" && currentAction != "Import" ? "active" : "")"
                           asp-controller="Transactions" asp-action="Index">
                            <i class="bi bi-list-columns-reverse me-1"></i>Opérations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Dashboard" && currentAction == "About" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="About">
                            <i class="bi bi-info-circle me-1"></i>À Propos
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-light" asp-controller="Transactions" asp-action="Create">
                        <i class="bi bi-plus-lg me-1"></i>Saisir
                    </a>
                    <a class="btn btn-sm btn-gold px-3" asp-controller="Transactions" asp-action="Import">
                        <i class="bi bi-shield-check me-1"></i>Coffre CSV & Import
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer-dinari py-3 mt-5">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning"></i>
                <span><strong>Dinari TND</strong> · Protection cryptographique SHA-256 active (aucune perte de données lors des imports CSV)</span>
            </div>
            <div>
                <span>Précision monétaire : <code class="text-warning">0.000 TND</code> (Millimes) · ASP.NET Core MVC &amp; SQLite</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
