@model Dinari.Models.Transaction
@{
    ViewData["Title"] = "Modifier la Transaction";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Modifier l'Opération #@Model.Id</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label fw-semibold"></label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AmountTnd" class="form-label fw-semibold"></label>
                            <input asp-for="AmountTnd" class="form-control" type="number" step="0.001" min="0.001" value="@Model.AmountTnd.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" />
                            <span asp-validation-for="AmountTnd" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-semibold"></label>
                            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<Dinari.Models.TransactionType>()"></select>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="autoCat" name="autoCategorize" value="true" />
                        <label class="form-check-label" for="autoCat">Recalculer automatiquement la catégorie selon le libellé</label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label fw-semibold">Catégorie</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Dinari.Models.TransactionCategory>()"></select>
                    </div>

                    <button type="submit" class="btn btn-primary px-4">Sauvegarder les modifications</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
