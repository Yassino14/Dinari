@model IEnumerable<Dinari.Models.Transaction>
@{
    ViewData["Title"] = "Opérations & Transactions";
    var categoryList = Html.GetEnumSelectList<Dinari.Models.TransactionCategory>().ToList();
    if (ViewBag.SelectedCategory != null)
    {
        string selectedVal = ((int)(Dinari.Models.TransactionCategory)ViewBag.SelectedCategory).ToString();
        foreach (var opt in categoryList)
        {
            opt.Selected = opt.Value == selectedVal;
        }
    }
    var batches = ViewBag.Batches as List<Dinari.Models.CsvImportBatch> ?? new List<Dinari.Models.CsvImportBatch>();
    int? selectedBatchId = ViewBag.SelectedBatchId as int?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-extrabold mb-0"><i class="bi bi-list-columns-reverse text-primary me-2"></i>Gestion des Opérations (TND)</h3>
        <small class="text-muted">Création, modification, filtrage par lot CSV et exportation de vos transactions protégées.</small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i>Ajouter une opération</a>
        <a asp-action="Import" class="btn btn-gold"><i class="bi bi-shield-check me-1"></i>Importer CSV</a>
        <a asp-action="ExportCsv"
           asp-route-category="@ViewBag.SelectedCategory"
           asp-route-search="@ViewBag.Search"
           asp-route-batchId="@selectedBatchId"
           class="btn btn-outline-success">
            <i class="bi bi-download me-1"></i>Exporter CSV
        </a>
    </div>
</div>

<div class="card card-dinari p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Rechercher un marchand (ex: STEG, Carrefour, Café...)" />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select" asp-items="categoryList">
                <option value="">-- Toutes les catégories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="batchId" class="form-select">
                <option value="">-- Tous les relevés CSV / Sources --</option>
                @foreach (var b in batches)
                {
                    if (selectedBatchId == b.Id)
                    {
                        <option value="@b.Id" selected>@b.FileName (@b.ImportedCount op.)</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.FileName (@b.ImportedCount op.)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Filtrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Réinitialiser"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card card-dinari overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dinari table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Libellé / Marchand</th>
                    <th>Catégorie</th>
                    <th>Source / Lot CSV</th>
                    <th class="text-end">Montant (TND)</th>
                    <th class="text-end pe-4" style="min-width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-nowrap">@item.Date.ToString("dd/MM/yyyy")</td>
                        <td class="fw-bold text-dark">@item.Description</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(_ => item.Category)</span></td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi @(item.IsAutoCategorized ? "bi-cpu text-primary" : "bi-person-check text-success") me-1"></i>
                                @item.SourceLabel
                            </span>
                        </td>
                        <td class="text-end fw-bold font-mono-tnd @(item.Type == Dinari.Models.TransactionType.Income ? "text-success" : "text-danger")">
                            @(item.Type == Dinari.Models.TransactionType.Income ? "+" : "-")@item.AmountTnd.ToString("0.000") TND
                        </td>
                        <td class="text-end pe-4 text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Supprimer cette transaction ?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
