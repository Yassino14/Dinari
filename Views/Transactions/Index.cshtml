@model IEnumerable<Dinari.Models.Transaction>
@{
    ViewData["Title"] = "Historique des Transactions";
    var categoryList = Html.GetEnumSelectList<Dinari.Models.TransactionCategory>().ToList();
    if (ViewBag.SelectedCategory != null)
    {
        string selectedVal = ((int)(Dinari.Models.TransactionCategory)ViewBag.SelectedCategory).ToString();
        foreach (var opt in categoryList)
        {
            opt.Selected = opt.Value == selectedVal;
        }
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Historique des Transactions (TND)</h3>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-dark">+ Ajouter une opération</a>
        <a asp-action="Import" class="btn btn-warning fw-semibold">Importer CSV</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Rechercher un marchand (ex: STEG, Carrefour, Café...)" />
    </div>
    <div class="col-md-4">
        <select name="category" class="form-select" asp-items="categoryList">
            <option value="">-- Toutes les catégories --</option>
        </select>
    </div>
    <div class="col-md-3 d-grid">
        <button type="submit" class="btn btn-outline-primary">Filtrer</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Libellé / Marchand</th>
                    <th>Catégorie</th>
                    <th>Source Cat.</th>
                    <th class="text-end">Montant (TND)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd/MM/yyyy")</td>
                        <td class="fw-semibold">@item.Description</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(_ => item.Category)</span></td>
                        <td>
                            <span class="badge @(item.IsAutoCategorized ? "bg-info text-dark" : "bg-light text-dark border")">
                                @(item.IsAutoCategorized ? "Auto IA/Règles" : "Manuelle")
                            </span>
                        </td>
                        <td class="text-end fw-bold @(item.Type == Dinari.Models.TransactionType.Income ? "text-success" : "text-danger")">
                            @(item.Type == Dinari.Models.TransactionType.Income ? "+" : "-")@item.AmountTnd.ToString("0.000") TND
                        </td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

