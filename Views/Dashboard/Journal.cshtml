@model Dinari.Models.JournalViewModel
@{
    ViewData["Title"] = "Journal des Dépenses & Revenus";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-extrabold mb-1">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Livre-Journal des Dépenses &amp; Revenus (TND)
        </h2>
        <p class="text-muted mb-0">
            Suivi comptable chronologique avec <strong>solde progressif cumulé</strong> au millime près (<code>0.000 TND</code>) et traçabilité de chaque relevé CSV.
        </p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" onclick="window.print()" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>Imprimer le Journal
        </button>
        <a asp-controller="Transactions" asp-action="ExportCsv"
           asp-route-category="@Model.SelectedCategory"
           asp-route-batchId="@Model.SelectedBatchId"
           asp-route-search="@Model.SearchQuery"
           class="btn btn-success">
            <i class="bi bi-download me-1"></i>Exporter CSV
        </a>
        <a asp-controller="Transactions" asp-action="Create" class="btn btn-gold">
            <i class="bi bi-plus-lg me-1"></i>Nouvelle écriture
        </a>
    </div>
</div>

<!-- Synthèse du Livre-Journal -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-dinari p-3 h-100">
            <div class="text-muted small text-uppercase fw-bold">Total Crédits / Revenus (+)</div>
            <div class="fs-4 fw-bold text-success font-mono-tnd mt-1">+@Model.TotalCreditIncomeTnd.ToString("0.000") TND</div>
            <small class="text-muted">Entrées sur la sélection</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-dinari p-3 h-100">
            <div class="text-muted small text-uppercase fw-bold">Total Débits / Dépenses (-)</div>
            <div class="fs-4 fw-bold text-danger font-mono-tnd mt-1">-@Model.TotalDebitExpenseTnd.ToString("0.000") TND</div>
            <small class="text-muted">Sorties sur la sélection</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-dinari p-3 h-100">
            <div class="text-muted small text-uppercase fw-bold">Flux Net de Trésorerie</div>
            <div class="fs-4 fw-bold @(Model.NetPeriodFlowTnd >= 0 ? "text-primary" : "text-danger") font-mono-tnd mt-1">
                @(Model.NetPeriodFlowTnd >= 0 ? "+" : "")@Model.NetPeriodFlowTnd.ToString("0.000") TND
            </div>
            <small class="text-muted">@Model.TotalEntriesCount écriture(s) comptabilisée(s)</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-hero-dark p-3 h-100">
            <div class="text-warning small text-uppercase fw-bold">Solde Progressif Final</div>
            <div class="fs-4 fw-bold text-white font-mono-tnd mt-1">@Model.ClosingBalanceTnd.ToString("0.000") TND</div>
            <small class="text-white-50">Solde d'ouverture : @Model.OpeningBalanceTnd.ToString("0.000") TND</small>
        </div>
    </div>
</div>

<!-- Barre de Filtres Multi-Critères -->
<div class="card card-dinari p-3 mb-4 no-print">
    <form method="get" asp-action="Journal" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted mb-1">Mois</label>
            <select name="month" class="form-select form-select-sm">
                <option value="">Tous les mois</option>
                @foreach (var m in Model.AvailableMonths)
                {
                    if (Model.SelectedMonth == m)
                    {
                        <option value="@m" selected>@m</option>
                    }
                    else
                    {
                        <option value="@m">@m</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted mb-1">Nature du Flux</label>
            <select name="type" class="form-select form-select-sm">
                <option value="">Revenus &amp; Dépenses</option>
                @if (Model.SelectedType == Dinari.Models.TransactionType.Income)
                {
                    <option value="Income" selected>Crédits / Revenus (+)</option>
                }
                else
                {
                    <option value="Income">Crédits / Revenus (+)</option>
                }
                @if (Model.SelectedType == Dinari.Models.TransactionType.Expense)
                {
                    <option value="Expense" selected>Débits / Dépenses (-)</option>
                }
                else
                {
                    <option value="Expense">Débits / Dépenses (-)</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Relevé CSV / Source</label>
            <select name="batchId" class="form-select form-select-sm">
                <option value="">Toutes les sources protégées</option>
                @foreach (var b in Model.ImportBatches)
                {
                    if (Model.SelectedBatchId == b.Id)
                    {
                        <option value="@b.Id" selected>@b.FileName</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.FileName</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Recherche Marchand / Libellé</label>
            <input type="text" name="search" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="Ex: STEG, Salaire, Aziza, Café..." />
        </div>

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filtrer</button>
            <a asp-action="Journal" class="btn btn-sm btn-outline-secondary" title="Réinitialiser"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Tableau du Livre-Journal -->
<div class="card card-dinari overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dinari table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Source Protégée</th>
                    <th>Libellé / Opération</th>
                    <th>Catégorie</th>
                    <th class="text-end text-danger">Débit (- Dépense)</th>
                    <th class="text-end text-success">Crédit (+ Revenu)</th>
                    <th class="text-end pe-4">Solde Progressif (TND)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">Aucune écriture comptable ne correspond à ces critères.</td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td class="ps-4 text-nowrap fw-semibold">@entry.Date.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-shield-lock text-success me-1"></i>@entry.SourceLabel
                                </span>
                            </td>
                            <td class="fw-bold text-dark">@entry.Description</td>
                            <td><span class="badge bg-secondary">@entry.CategoryName</span></td>
                            <td class="text-end font-mono-tnd">
                                @if (entry.DebitExpenseTnd > 0)
                                {
                                    <span class="text-danger fw-bold">-@entry.DebitExpenseTnd.ToString("0.000")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end font-mono-tnd">
                                @if (entry.CreditIncomeTnd > 0)
                                {
                                    <span class="text-success fw-bold">+@entry.CreditIncomeTnd.ToString("0.000")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end pe-4 font-mono-tnd">
                                <span class="badge @(entry.RunningBalanceTnd >= 0 ? "badge-soft-success" : "badge-soft-danger") fs-6">
                                    @entry.RunningBalanceTnd.ToString("0.000") TND
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="4" class="ps-4 py-3 text-uppercase small">Totaux de la sélection (@Model.TotalEntriesCount écritures)</td>
                    <td class="text-end text-danger font-mono-tnd py-3">-@Model.TotalDebitExpenseTnd.ToString("0.000") TND</td>
                    <td class="text-end text-success font-mono-tnd py-3">+@Model.TotalCreditIncomeTnd.ToString("0.000") TND</td>
                    <td class="text-end pe-4 font-mono-tnd py-3">Flux Net : @(Model.NetPeriodFlowTnd >= 0 ? "+" : "")@Model.NetPeriodFlowTnd.ToString("0.000") TND</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
